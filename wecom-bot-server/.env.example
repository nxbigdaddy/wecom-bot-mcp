# 企业微信配置
WECOM_BOT_WEBHOOK_KEY=your-webhook-key-here

# 服务器配置
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# 数据库配置
DATABASE_TYPE=sqlite  # sqlite, mysql, postgresql

# SQLite 配置
SQLITE_DB_PATH=./data/wecom_bot.db

# MySQL 配置（DATABASE_TYPE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_PASSWORD
MYSQL_DATABASE=wecom_bot

# PostgreSQL 配置（DATABASE_TYPE=postgresql 时使用）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DATABASE=wecom_bot
